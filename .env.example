# Safe to expose: identifies the Supabase project used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Safe to expose: the anonymous key is constrained by PostgreSQL Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret: bypasses RLS and must never be imported into browser code.
SUPABASE_SECRET_KEY=

# Legacy fallback for projects that have not migrated to secret API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Public application origin used for invitation and password-setup redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
